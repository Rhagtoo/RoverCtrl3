<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_video.xml v3.0 — полоски турели как на control tab:
  PAN горизонтальная слева (замена джойстика), TILT вертикальная справа
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true">

    <!-- CameraX Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/toolbar_video"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Overlay трекинга для камеры телефона -->
    <org.rhanet.roverctrl.ui.video.TrackingOverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/preview_view"
        app:layout_constraintBottom_toBottomOf="@id/preview_view"
        app:layout_constraintStart_toStartOf="@id/preview_view"
        app:layout_constraintEnd_toEndOf="@id/preview_view" />

    <!-- ═══ Overlay: полоска PAN турели (слева, заменяет джойстик) ═══ -->
    <LinearLayout
        android:id="@+id/turret_pan_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0.85"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/toolbar_video"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_pan_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◄ PAN ►"
            android:textColor="#55FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <org.rhanet.roverctrl.ui.control.SliderView
            android:id="@+id/slider_turret_pan"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:alpha="0.85" />

    </LinearLayout>

    <!-- ═══ Overlay: полоска TILT турели (справа) ═══ -->
    <LinearLayout
        android:id="@+id/turret_tilt_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0.85"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/toolbar_video"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_tilt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▲ TILT ▼"
            android:textColor="#55FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <org.rhanet.roverctrl.ui.control.SliderView
            android:id="@+id/slider_turret_tilt"
            android:layout_width="48dp"
            android:layout_height="140dp"
            android:alpha="0.85" />

    </LinearLayout>

    <!-- Лазер (Manual) — по центру между полосками -->
    <ToggleButton
        android:id="@+id/btn_laser_video"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:textOn="🔴"
        android:textOff="⚫"
        android:textSize="16sp"
        android:background="#60333333"
        android:alpha="0.7"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/toolbar_video"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp" />

    <!-- ═══ TOP-LEFT HUD: статус + латенси ═══ -->
    <LinearLayout
        android:id="@+id/video_hud_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#80000000"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="8dp">

        <!-- Режим трекинга -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manual"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Латенси -->
        <TextView
            android:id="@+id/tv_latency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- ms"
            android:textColor="#FF9800"
            android:textSize="11sp"
            android:visibility="visible" />
    </LinearLayout>

    <!-- TOP-RIGHT: FPS камеры -->
    <TextView
        android:id="@+id/tv_fps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 FPS"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="6dp"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp" />

    <!-- Нижняя панель -->
    <LinearLayout
        android:id="@+id/toolbar_video"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#222222"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode:"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <Spinner
            android:id="@+id/spinner_mode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="#333333"
            android:popupBackground="#333333" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_calibrate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Cal"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
